# The exact address you open Folio at. HTTPS, or http://localhost:PORT for a local try.
FOLIO_ORIGIN=https://folio.example.com
PORT=4173

# Node.js install: where the SQLite database lives.
FOLIO_DB_PATH=./data/folio.sqlite

# Docker only (optional):
# FOLIO_DATA_DIR=./data
# FOLIO_UID=1000
# FOLIO_GID=1000
# FOLIO_IMAGE=ghcr.io/silent-protocol-inc/folio:latest

# Optional AI financial plan. Keep real keys only in your owner-only .env file.
# Never commit this file after inserting keys. If neither key is set, its button stays unavailable.
# FOLIO_OPENAI_API_KEY=
# FOLIO_CODEX_MODEL=gpt-6-luna
# FOLIO_ANTHROPIC_API_KEY=
# FOLIO_CLAUDE_MODEL=claude-haiku-4-5
