{
  "name": "folio-personal-finance",
  "version": "1.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node --env-file=.env scripts/serve.mjs",
    "account:add": "node --env-file=.env scripts/account.mjs",
    "check": "for f in server/*.js scripts/*.mjs public/*.js design/*.mjs docs/demo/*.mjs test/*.mjs; do node --check \"$f\" || exit 1; done",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.1.0"
  },
  "devDependencies": {
    "esbuild": "0.27.3"
  },
  "engines": {
    "node": ">=24"
  }
}
